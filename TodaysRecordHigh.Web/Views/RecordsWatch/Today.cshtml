@model TodaysRecordHigh.Web.Models.RecordWatchSnapshot?
@{
    Layout = "_Layout";
    var todayLabel = Model?.DateLabel ?? SiteClock.Now.ToString("MMMM d");
    var closestOverall = Model?.Entries
        .Where(e => e.Margin.HasValue)
        .OrderBy(e => e.Margin)
        .Take(12)
        .ToList() ?? [];
}

<style>
    .watch-row { transition: background-color .15s; }
    .watch-row:hover { background-color: rgba(0,0,0,0.02); }
    .watch-temp { font-size: 1.3rem; font-weight: 800; }
    .refresh-note { font-size: .78rem; }
</style>

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Records Watch</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h2 fw-bold mb-1">🔥 Records Watch — @todayLabel</h1>
        <p class="text-muted mb-0">
            Which U.S. cities are closest to their all-time record high for today's date, right now.
        </p>
        @if (Model is not null)
        {
            <p class="text-muted refresh-note mb-0 mt-1">
                Scanned @Model.StationsWithData of @Model.StationsScanned stations &middot;
                updated @SiteClock.ToCentral(Model.GeneratedAtUtc).ToString("h:mm tt") CT &middot;
                refreshes automatically every 30 minutes
            </p>
        }
    </div>

    @if (Model is null)
    {
        <div class="alert alert-info">
            <strong>Building today's list.</strong> The first scan runs shortly after the site starts —
            check back in a few minutes.
        </div>
    }
    else
    {
        @if (Model.Broken.Count > 0)
        {
            <section class="mb-5">
                <h2 class="h5 fw-bold mb-1">
                    <span class="badge bg-danger me-1">✅</span> Records Broken or Tied Today
                </h2>
                <p class="text-muted small mb-3">Confirmed by an actual reading, not a forecast.</p>
                <div class="row g-3">
                    @foreach (var e in Model.Broken)
                    {
                        <div class="col-sm-6 col-lg-4">
                            <a href="/stations/@e.Slug" class="text-decoration-none text-reset">
                                <div class="card h-100 border-0 shadow-sm watch-row" style="background:#fff1f1;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="fw-semibold">@e.City, @e.State</div>
                                            <span>@e.WeatherEmoji</span>
                                        </div>
                                        <div class="watch-temp text-danger mt-1">
                                            @e.CurrentTemp?.ToString("F0")°F
                                            <span class="fs-6 fw-normal text-muted">observed now</span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Record: @e.RecordTemp°F@(e.RecordYear.HasValue ? $" (since {e.RecordYear})" : "")
                                        </div>
                                        <span class="badge bg-danger bg-opacity-75 mt-2">@e.ObservedMarginDisplay</span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </section>
        }

        @if (Model.OnTrack.Count > 0)
        {
            <section class="mb-5">
                <h2 class="h5 fw-bold mb-1">
                    <span class="badge bg-warning text-dark me-1">🎯</span> On Track to Break a Record Today
                </h2>
                <p class="text-muted small mb-3">
                    Today's forecast high would beat the record — not confirmed yet, this is a projection
                    that can still miss by a few degrees.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>City</th>
                                <th class="text-end">Current</th>
                                <th class="text-end">Forecast High</th>
                                <th class="text-end">Record</th>
                                <th class="text-end">Projected Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.OnTrack)
                        {
                            <tr class="watch-row">
                                <td><a href="/stations/@e.Slug" class="text-decoration-none">@e.City, @e.State</a></td>
                                <td class="text-end text-muted">@e.WeatherEmoji @e.CurrentTemp?.ToString("F0")°F</td>
                                <td class="text-end fw-semibold">@e.ForecastHigh?.ToString("F0")°F</td>
                                <td class="text-end text-muted">
                                    @e.RecordTemp°F@(e.RecordYear.HasValue ? $", {e.RecordYear}" : "")
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-warning text-dark">@e.ForecastMarginDisplay</span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (Model.Close.Count > 0)
        {
            <section class="mb-5">
                <h2 class="h5 fw-bold mb-3">
                    <span class="badge bg-secondary me-1">🔥</span> Within 5°F of a Record
                </h2>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>City</th>
                                <th class="text-end">Current</th>
                                <th class="text-end">Forecast High</th>
                                <th class="text-end">Record</th>
                                <th class="text-end">Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.Close)
                        {
                            <tr class="watch-row">
                                <td><a href="/stations/@e.Slug" class="text-decoration-none">@e.City, @e.State</a></td>
                                <td class="text-end">@e.WeatherEmoji @e.CurrentTemp?.ToString("F0")°F</td>
                                <td class="text-end text-muted">@e.ForecastHigh?.ToString("F0")°F</td>
                                <td class="text-end text-muted">
                                    @e.RecordTemp°F@(e.RecordYear.HasValue ? $", {e.RecordYear}" : "")
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-secondary">@e.MarginDisplay</span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (Model.Notable.Count == 0)
        {
            <div class="alert alert-light border mb-4">
                No station is within 5°F of its record for @todayLabel right now — a quiet weather day
                nationally. Here's how close the nearest ones are:
            </div>

            @if (closestOverall.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>City</th>
                                <th class="text-end">Current</th>
                                <th class="text-end">Forecast High</th>
                                <th class="text-end">Record</th>
                                <th class="text-end">Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in closestOverall)
                        {
                            <tr class="watch-row">
                                <td><a href="/stations/@e.Slug" class="text-decoration-none">@e.City, @e.State</a></td>
                                <td class="text-end">@e.WeatherEmoji @e.CurrentTemp?.ToString("F0")°F</td>
                                <td class="text-end text-muted">@e.ForecastHigh?.ToString("F0")°F</td>
                                <td class="text-end text-muted">
                                    @e.RecordTemp°F@(e.RecordYear.HasValue ? $", {e.RecordYear}" : "")
                                </td>
                                <td class="text-end text-muted">@e.Margin?.ToString("F0")° away</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }

        <section class="p-4 bg-light rounded small text-muted mt-4">
            <strong class="text-dark">About this page.</strong> "Today" is a record high for this
            calendar date at each station's period of record (NOAA Threadex via RCC ACIS), the same
            record shown on every station page. <strong>Records Broken or Tied</strong> comes only
            from an actual observed reading &mdash; never a forecast. <strong>On Track to Break</strong>
            uses today's forecast high (Open-Meteo) as a momentum signal; it's a projection, not a
            confirmed record, and same-day forecasts can miss by a few degrees. This list is a
            background scan of every station with Threadex data, refreshed every 30 minutes, not
            computed live per visit.
        </section>
    }
</div>
