    }

    // Warm Nights Per Year
    const wnData = @Html.Raw(warmNightsJson);
    const wnHistAvg = @Html.Raw(warmNightsHistAvg);
    const wnCtx = document.getElementById('warmNightsChart');
    if (wnCtx && wnData.length > 0) {
        new Chart(wnCtx, {
            type: 'bar',
            data: {
                labels: wnData.map(d => d.year),
                datasets: [
                    {
                        label: 'Above-normal nights',
                        data: wnData.map(d => d.count),
                        backgroundColor: wnData.map(d => d.year === currentYear ? 'rgba(234,179,8,0.85)' : 'rgba(109,40,217,0.65)'),
                        borderWidth: 0, borderRadius: 2, order: 2
                    },
                    ...(wnHistAvg != null ? [{
                        label: `Avg 1970–2020 (${parseFloat(wnHistAvg).toFixed(1)} nights)`,
                        data: wnData.map(() => wnHistAvg),
                        type: 'line', borderColor: 'rgba(0,0,0,0.4)', borderWidth: 1.5, borderDash: [4,4], pointRadius: 0, fill: false, order: 1
                    }] : [])
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 16 } },
                    tooltip: {
                        callbacks: {
                            title: (items) => { const d = wnData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (through yesterday)` : String(d.year); },
                            label: (item) => item.dataset.type === 'line' ? `Avg (1970–2020): ${parseFloat(wnHistAvg).toFixed(1)} nights` : `${item.raw} above-normal nights`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? wnData[i]?.year : '' } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, title: { display: true, text: 'Nights above normal' } }
                }
            }
        });
