    // The server works in MM-DD only (a window repeated across every year on record);
    // the date inputs need a full date to render, so a fixed reference year fills that
    // in and gets stripped again before the form submits.
    function initRangePicker() {
        const form = document.getElementById('rangePickerForm');
        if (!form) return;

        const startInput  = document.getElementById('rangeStartInput');
        const endInput    = document.getElementById('rangeEndInput');
        const startHidden = document.getElementById('rangeStartHidden');
        const endHidden   = document.getElementById('rangeEndHidden');
        const refYear = new Date().getFullYear();

        const toDateValue = monthDay => `${refYear}-${monthDay}`;
        const toMonthDay = dateValue => dateValue.slice(5); // "yyyy-MM-dd" -> "MM-dd"

        startInput.value = toDateValue(startHidden.value);
        endInput.value = toDateValue(endHidden.value);

        form.addEventListener('submit', () => {
            startHidden.value = toMonthDay(startInput.value);
            endHidden.value = toMonthDay(endInput.value);
        });
    }

