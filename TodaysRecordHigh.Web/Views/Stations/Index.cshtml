@model TodaysRecordHigh.Web.ViewModels.StationDetailViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.Station.City}, {Model.Station.State} – Record High Temperatures | Today's Record High";
    ViewData["MetaDescription"] = Model.AllTimeRecordTemp.HasValue
        ? $"All-time record high for {Model.TodayLabel} in {Model.Station.City}, {Model.Station.State}: {Model.AllTimeRecordTemp}°F. Explore record lows, heat waves, departure from normal, precipitation history, and warm nights trends. NOAA Threadex data since {Model.PeriodOfRecordStart?.Substring(0, 4)}."
        : $"Explore all-time record high and low temperatures, heat wave history, precipitation, and climate trends for {Model.Station.City}, {Model.Station.State}. NOAA Threadex historical data.";

    // Pre-serialize chart data for JS
    var hotDaysJson = JsonSerializer.Serialize(Model.HotDaysPerYear.Select(x => new { year = x.Year, count = x.Count }));
    var ytdJson = JsonSerializer.Serialize(Model.YtdDepartures.Select(d => new {
        date = d.Date, actual = d.ActualTemp, normal = d.NormalTemp, departure = d.Departure
    }));
    var warmNightsJson    = JsonSerializer.Serialize(Model.WarmNights?.WarmNightsPerYear.Select(x => new { year = x.Year, count = x.Count }) ?? []);
    var decadeJson        = JsonSerializer.Serialize(Model.WarmNights?.AvgLowByDecade.Select(x => new { label = x.Label, avgLow = Math.Round(x.AvgLow, 1) }) ?? []);
    var warmNightsHistAvg = Model.WarmNights?.HistoricalAvg?.ToString("F1") ?? "null";
    var precipAnnualJson  = JsonSerializer.Serialize(Model.Precip?.AnnualTotals.Select(x => new { year = x.Year, actual = x.Actual, normal = x.Normal }) ?? []);
    var precipMonthlyJson = JsonSerializer.Serialize(Model.Precip?.MonthlyLast24.Select(x => new { year = x.Year, month = x.Month, actual = x.Actual, normal = x.Normal }) ?? []);
    var precipHeavyJson   = JsonSerializer.Serialize(Model.Precip?.HeavyRainDaysPerYear.Select(x => new { year = x.Year, count = x.Count }) ?? []);
    var precipYtdCumJson  = JsonSerializer.Serialize(Model.Precip?.YtdCumulative.Select(x => new {
        date = x.Date, actual = x.CumActual, normal = x.CumNormal
    }) ?? []);
    var precipAnnualTrend = Model.Precip?.AnnualTrend;
    var precipAnnualTrendJson = precipAnnualTrend is { } at
        ? JsonSerializer.Serialize(new { perYear = at.PerYear, intercept = at.Intercept, perDecade = at.PerDecade })
        : "null";
    var precipFirstYear = Model.Precip is { AnnualTotals.Count: > 0 } pd ? pd.AnnualTotals[0].Year : (int?)null;
    var heatWaveFreqJson    = JsonSerializer.Serialize(Model.HeatWaves?.EventsPerYear.Select(x => new { year = x.Year, count = x.Count }) ?? []);
    var dangerousNightsJson = JsonSerializer.Serialize(Model.HeatWaves?.DangerousNightsPerYear.Select(x => new { year = x.Year, count = x.Count }) ?? []);
    var avgHighDecadeJson   = JsonSerializer.Serialize(Model.HeatWaves?.AvgHighByDecade.Select(x => new { label = x.Decade, avgHigh = x.AvgHigh }) ?? []);
    var mr = Model.MonthReview;
    var monthHistoryJson = JsonSerializer.Serialize(mr?.SameMonthHistory.Select(x => new {
        year = x.Year, avg = TodaysRecordHigh.Web.Models.TempFormat.Round1(x.AvgTemp)
    }) ?? []);
    var monthNormalJson = mr?.NormalAvgTemp is { } n ? TodaysRecordHigh.Web.Models.TempFormat.Round1(n).ToString("F1") : "null";

    var mp = mr?.Precip;
    var monthPrecipJson = JsonSerializer.Serialize(mp?.SameMonthHistory.Select(x => new {
        year = x.Year, total = x.Total
    }) ?? []);
    var monthPrecipNormalJson = mp?.NormalTotal is { } pn ? pn.ToString("F2") : "null";
    // Trend lines are drawn from the fitted slope, so the chart never re-fits in JS.
    var monthTempTrendJson = mr?.SameMonthTrend is { } tt
        ? JsonSerializer.Serialize(new { perYear = tt.PerYear, intercept = tt.Intercept }) : "null";
    var monthPrecipTrendJson = mp?.SameMonthTrend is { } pt
        ? JsonSerializer.Serialize(new { perYear = pt.PerYear, intercept = pt.Intercept }) : "null";
    var availableYearsJson = JsonSerializer.Serialize(mr?.AvailableYearsByMonth ?? new Dictionary<int, List<int>>());

    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
    var monthName = DateTime.Now.ToString("MMMM");

    var hasHeatData = Model.HeatWaves != null || (Model.WarmNights != null && Model.WarmNights.WarmNightsPerYear.Count > 0) || Model.HotDaysPerYear.Count > 5 || Model.YtdDepartures.Count > 10;
}

@section Head {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Home", "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/")" },
    { "@@type": "ListItem", "position": 2, "name": "All Stations", "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/stations")" },
    { "@@type": "ListItem", "position": 3, "name": "@Model.Station.City, @Model.Station.State", "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/stations/{Model.Station.Slug}")" }
  ]
}
</script>
@if (Model.HasData)
{
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Dataset",
      "name": "All-Time Record High Temperatures – @Model.Station.City, @Model.Station.State",
      "description": "@(ViewData["MetaDescription"]?.ToString()?.Replace("\"","'"))",
      "temporalCoverage": "@Model.PeriodOfRecordStart/@Model.PeriodOfRecordEnd",
      "spatialCoverage": {
        "@@type": "Place",
        "name": "@Model.Station.City, @Model.Station.StateName",
        "address": { "@@type": "PostalAddress", "addressLocality": "@Model.Station.City", "addressRegion": "@Model.Station.State", "addressCountry": "US" }
        @if (Model.Station.Latitude.HasValue && Model.Station.Longitude.HasValue) {
            <text>,"geo":{"@@type":"GeoCoordinates","latitude":@Model.Station.Latitude.Value,"longitude":@Model.Station.Longitude.Value}</text>
        }
      },
      "provider": { "@@type": "Organization", "name": "NOAA / RCC ACIS", "url": "https://www.rcc-acis.org/" }
    }
    </script>
}
}

<style>
    .stat-hero-card { border-radius: 12px; }
    .stat-hero-temp { font-size: 3.5rem; font-weight: 800; line-height: 1; }
    .extreme-card { border-radius: 10px; transition: box-shadow 0.15s; }
    .extreme-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .extreme-icon { font-size: 1.8rem; }
    .normal-badge { font-size: 0.85rem; }
    .chart-container { position: relative; height: 280px; }
    .section-divider { border: 0; border-top: 2px solid #f0f0f0; margin: 2rem 0; }
    .streak-widget { border-radius: 14px; background: linear-gradient(135deg, #fff7ed 0%, #fee2e2 100%); border: 1px solid #fca5a5; }
    .streak-number { font-size: 3.5rem; font-weight: 900; color: #dc2626; line-height: 1; }
    @@media (max-width: 576px) { .stat-hero-temp { font-size: 2.6rem; } .streak-number { font-size: 2.6rem; } }
</style>

<div class="container mt-4 mb-5">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">@Model.Station.DisplayName</li>
        </ol>
    </nav>

    <!-- Station header -->
    <div class="mb-4">
        <h1 class="h2 fw-bold mb-1">@Model.Station.City, @Model.Station.State</h1>
        <p class="text-muted mb-0 small">
            @Model.Station.StateName
            @if (Model.PeriodOfRecordStart is not null) {
                <span class="mx-1">&middot;</span>
                <span>Records since @Model.PeriodOfRecordLabel</span>
            }
        </p>
    </div>

    <!-- Current conditions banner -->
    @if (Model.Current is not null)
    {
        var asOf = Model.Current.AsOf != default
            ? Model.Current.AsOf.ToString("h:mm tt") + (string.IsNullOrEmpty(Model.Current.TimezoneAbbr) ? "" : $" {Model.Current.TimezoneAbbr}")
            : "";
        <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3 border" style="background:#f8fafc;">
            <div>
                <span class="fs-3 fw-bold">@Model.Current.WeatherEmoji @Model.Current.TempF.ToString("F0")°F</span>
                @if (Math.Abs(Model.Current.FeelsLikeF - Model.Current.TempF) >= 3)
                {
                    <span class="text-muted ms-2 small">Feels like @Model.Current.FeelsLikeF.ToString("F0")°</span>
                }
            </div>
            <div class="flex-grow-1">
                <div class="fw-semibold small">Currently in @Model.Station.City</div>
                @if (!string.IsNullOrEmpty(asOf))
                {
                    <div class="text-muted" style="font-size:.8rem">As of @asOf</div>
                }
            </div>
            @if (Model.RecordProximityLabel is not null)
            {
                <div class="badge bg-@Model.RecordProximityCssClass fs-6 px-3 py-2 text-wrap text-start"
                     style="max-width:220px;line-height:1.3;">
                    @if (Model.RecordProximityCssClass == "danger" && Model.AllTimeRecordTemp.HasValue && Model.Current.TempF >= Model.AllTimeRecordTemp.Value)
                    {
                        <text>🚨 </text>
                    }
                    else if (Model.RecordProximityCssClass is "danger" or "warning")
                    {
                        <text>🔥 </text>
                    }
                    @Model.RecordProximityLabel
                </div>
            }
        </div>
    }

    <!-- Record at or above the daily date record alert -->
    @if (Model.RecordBrokenToday)
    {
        var currentF = Model.Current!.TempF.ToString("F0");
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-4" role="alert">
            <span style="font-size:1.6rem">🚨</span>
            <div>
                <strong>Record territory right now!</strong>
                @Model.Station.City is currently at <strong>@currentF°F</strong> —
                at or above the all-time record high for <strong>@Model.TodayLabel</strong>
                of @Model.AllTimeRecordTemp°F.
            </div>
        </div>
    }

    @if (!Model.HasData)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3" role="alert">
            <span style="font-size:1.5rem">&#9888;</span>
            <div>
                <strong>No climate data available</strong> for this station.
                <a href="@Context.Request.Path" class="alert-link">Refresh</a> or
                <a href="/" class="alert-link">return home</a>.
            </div>
        </div>
    }
    else
    {
        <!-- Tab navigation -->
        <ul class="nav nav-tabs mb-4" id="stationTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-records"
                        type="button" role="tab" aria-selected="true">Records</button>
            </li>
            @if (hasHeatData)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-heat"
                            type="button" role="tab">Heat</button>
                </li>
            }
            @if (Model.Precip is not null)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-precipitation"
                            type="button" role="tab">Precipitation</button>
                </li>
            }
            @if (mr is not null)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-month"
                            type="button" role="tab">Month in Review</button>
                </li>
            }
        </ul>

        <div class="tab-content" id="stationTabContent">

        <!-- ══════════════════════════════════════════════════════════════════
             RECORDS TAB
        ═══════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="tab-records" role="tabpanel">

        <!-- Today's date records (High + Low) -->
        <section class="mb-4">
            <p class="text-uppercase fw-semibold text-muted small mb-3">
                Records for <strong class="text-dark">@Model.TodayLabel</strong>
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="card stat-hero-card border-0 bg-danger bg-opacity-10 h-100">
                        <div class="card-body text-center py-4">
                            <p class="text-danger fw-semibold small text-uppercase mb-2">&#x1F525; Record High</p>
                            @if (Model.AllTimeRecordTemp.HasValue)
                            {
                                <div class="stat-hero-temp text-danger">@Model.AllTimeRecordTemp°F</div>
                                @if (Model.AllTimeRecordDate is not null && DateTime.TryParse(Model.AllTimeRecordDate, out var rhi))
                                {
                                    <p class="text-muted mt-2 mb-1 small">@rhi.ToString("MMMM d, yyyy")</p>
                                }
                                @if (Model.NormalMaxTemp.HasValue)
                                {
                                    var dep = Model.RecordHighDepartureFromNormal!.Value;
                                    <span class="badge bg-danger bg-opacity-10 text-danger normal-badge">
                                        @(dep >= 0 ? "+" : "")@dep.ToString("F0")° from @Model.NormalMaxTemp.Value.ToString("F0")° normal
                                    </span>
                                }
                            }
                            else { <p class="text-muted">No data</p> }
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card stat-hero-card border-0 bg-primary bg-opacity-10 h-100">
                        <div class="card-body text-center py-4">
                            <p class="text-primary fw-semibold small text-uppercase mb-2">&#x2744; Record Low</p>
                            @if (Model.AllTimeRecordLowTemp.HasValue)
                            {
                                <div class="stat-hero-temp text-primary">@Model.AllTimeRecordLowTemp°F</div>
                                @if (Model.AllTimeRecordLowDate is not null && DateTime.TryParse(Model.AllTimeRecordLowDate, out var rlo))
                                {
                                    <p class="text-muted mt-2 mb-1 small">@rlo.ToString("MMMM d, yyyy")</p>
                                }
                                @if (Model.NormalMinTemp.HasValue)
                                {
                                    var dep = Model.RecordLowDepartureFromNormal!.Value;
                                    <span class="badge bg-primary bg-opacity-10 text-primary normal-badge">
                                        @(dep >= 0 ? "+" : "")@dep.ToString("F0")° from @Model.NormalMinTemp.Value.ToString("F0")° normal
                                    </span>
                                }
                            }
                            else { <p class="text-muted">No data</p> }
                        </div>
                    </div>
                </div>
            </div>
            @if (Model.NormalMaxTemp.HasValue || Model.NormalMinTemp.HasValue)
            {
                <div class="mt-3 px-1 d-flex gap-4 small text-muted">
                    @if (Model.NormalMaxTemp.HasValue) { <span>&#127774; Normal high: <strong>@Model.NormalMaxTemp.Value.ToString("F0")°F</strong></span> }
                    @if (Model.NormalMinTemp.HasValue) { <span>&#127761; Normal low: <strong>@Model.NormalMinTemp.Value.ToString("F0")°F</strong></span> }
                    <span class="ms-auto text-muted" style="font-size:0.75rem">1991–2020 normals</span>
                </div>
            }
        </section>

        <hr class="section-divider" />

        <!-- All-Time Extremes -->
        @if (Model.Extremes is not null)
        {
            <section class="mb-4">
                <h2 class="h5 fw-bold mb-3">All-Time Records — @Model.Station.City</h2>
                <div class="row g-3">
                    @{
                        string FormatExtremeDate(string? d) =>
                            d is not null && DateTime.TryParse(d, out var dt)
                                ? dt.ToString("MMM d, yyyy") : (d ?? "—");
                    }
                    <div class="col-6 col-md-3">
                        <div class="card extreme-card border-0 h-100" style="background:#fff5f5;">
                            <div class="card-body text-center py-3 px-2">
                                <div class="extreme-icon mb-1">&#x1F525;</div>
                                <div class="fw-bold text-danger fs-4">@(Model.Extremes.MaxTemp.HasValue ? $"{Model.Extremes.MaxTemp}°F" : "—")</div>
                                <div class="small text-muted mt-1">Hottest Day Ever</div>
                                <div class="small fw-medium">@FormatExtremeDate(Model.Extremes.MaxTempDate)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card extreme-card border-0 h-100" style="background:#f0f5ff;">
                            <div class="card-body text-center py-3 px-2">
                                <div class="extreme-icon mb-1">&#x2744;</div>
                                <div class="fw-bold text-primary fs-4">@(Model.Extremes.MinTemp.HasValue ? $"{Model.Extremes.MinTemp}°F" : "—")</div>
                                <div class="small text-muted mt-1">Coldest Day Ever</div>
                                <div class="small fw-medium">@FormatExtremeDate(Model.Extremes.MinTempDate)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card extreme-card border-0 h-100" style="background:#f0f8ff;">
                            <div class="card-body text-center py-3 px-2">
                                <div class="extreme-icon mb-1">&#x1F327;</div>
                                <div class="fw-bold text-info fs-4">@(Model.Extremes.MaxPcpn.HasValue ? $"{Model.Extremes.MaxPcpn.Value:F2}\"" : "—")</div>
                                <div class="small text-muted mt-1">Wettest Day Ever</div>
                                <div class="small fw-medium">@FormatExtremeDate(Model.Extremes.MaxPcpnDate)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card extreme-card border-0 h-100" style="background:#f8f8ff;">
                            <div class="card-body text-center py-3 px-2">
                                <div class="extreme-icon mb-1">&#x2603;</div>
                                <div class="fw-bold fs-4" style="color:#6366f1;">@(Model.Extremes.MaxSnow.HasValue ? $"{Model.Extremes.MaxSnow.Value:F1}\"" : "—")</div>
                                <div class="small text-muted mt-1">Most Snow in One Day</div>
                                <div class="small fw-medium">@FormatExtremeDate(Model.Extremes.MaxSnowDate)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <hr class="section-divider" />
        }

        <!-- Record tables -->
        <section class="mb-4">
            <div class="row g-4">
                <div class="col-md-7">
                    <h2 class="h5 fw-bold mb-3">Top 10 Record Highs — @Model.TodayLabel</h2>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0">
                            <thead class="table-danger table-sm">
                                <tr>
                                    <th class="text-center" style="width:2.5rem">#</th>
                                    <th>Temp</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopRecords.Count; i++)
                                {
                                    var rec = Model.TopRecords[i];
                                    <tr class="@(i == 0 ? "fw-semibold" : "")">
                                        <td class="text-center text-muted small">@(i == 0 ? "🏆" : (i + 1).ToString())</td>
                                        <td class="text-danger">@rec.Temp°F</td>
                                        <td class="small">@rec.FormattedDate</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (Model.TopRecordLows.Count > 0)
                {
                    <div class="col-md-5">
                        <h2 class="h5 fw-bold mb-3">Top 5 Record Lows — @Model.TodayLabel</h2>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                <thead class="table-primary table-sm">
                                    <tr>
                                        <th class="text-center" style="width:2.5rem">#</th>
                                        <th>Temp</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.TopRecordLows.Count; i++)
                                    {
                                        var rec = Model.TopRecordLows[i];
                                        <tr class="@(i == 0 ? "fw-semibold" : "")">
                                            <td class="text-center text-muted small">@(i == 0 ? "🥶" : (i + 1).ToString())</td>
                                            <td class="text-primary">@rec.Temp°F</td>
                                            <td class="small">@rec.FormattedDate</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="p-4 bg-light rounded small text-muted mt-2">
            <strong class="text-dark">About this data</strong> &mdash;
            Records are sourced from the
            <a href="https://www.rcc-acis.org/" target="_blank" rel="noopener" class="text-muted">NOAA Threadex dataset via RCC ACIS</a>,
            a quality-controlled record for long-term climate stations. Threadex adjusts for station
            relocations and observation-time changes, making records comparable across all years since
            <strong>@Model.PeriodOfRecordLabel</strong>.
            Climate normals represent the 1991–2020 average.
        </section>

        </div><!-- /#tab-records -->

        <!-- ══════════════════════════════════════════════════════════════════
             HEAT TAB
        ═══════════════════════════════════════════════════════════════════ -->
        @if (hasHeatData)
        {
        <div class="tab-pane fade" id="tab-heat" role="tabpanel">
        <div class="pt-3">

        @{
            var hw = Model.HeatWaves;
            var wn = Model.WarmNights;
            var isSummer = DateTime.Now.Month is >= 6 and <= 8;
        }

        <!-- Current streak widget -->
        @if (hw != null && hw.CurrentStreak > 0)
        {
            var daysToWave = 3 - hw.CurrentStreak;
            <div class="streak-widget p-4 mb-4 d-flex align-items-center gap-4">
                <div class="text-center flex-shrink-0">
                    <div class="streak-number">@hw.CurrentStreak</div>
                    <div class="small fw-semibold text-danger">day@(hw.CurrentStreak == 1 ? "" : "s")</div>
                </div>
                <div>
                    <div class="fw-bold fs-5 mb-1">
                        @(hw.StreakIsHeatWave ? "🔥 Heat Wave in Progress" : "Hot Streak")
                    </div>
                    <div class="text-muted small mb-2">
                        @hw.CurrentStreak consecutive day@(hw.CurrentStreak == 1 ? "" : "s") at or above @hw.HeatWaveThreshold°F
                        @if (hw.StreakStartDate != null && DateTime.TryParse(hw.StreakStartDate, out var sd))
                        {
                            <span>&middot; since @sd.ToString("MMMM d")</span>
                        }
                    </div>
                    @if (hw.StreakIsHeatWave)
                    {
                        <span class="badge bg-danger px-3 py-2">Heat wave in progress (3+ days ≥ @hw.HeatWaveThreshold°F)</span>
                    }
                    else if (daysToWave > 0)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">@daysToWave more day@(daysToWave == 1 ? "" : "s") to heat wave status</span>
                    }
                </div>
            </div>
        }

        <!-- Heat wave summary stats -->
        @if (hw != null && (hw.TopEvents.Count > 0 || hw.HistoricalAvgDuration.HasValue || hw.DangerousNightsThisYear > 0))
        {
            var thisYearHwCount = hw.EventsPerYear.FirstOrDefault(e => e.Year == currentYear).Count;
            <section class="mb-4">
                <div class="d-flex align-items-baseline gap-3 mb-3">
                    <h2 class="h5 fw-bold mb-0">Heat Wave Summary — @Model.Station.City</h2>
                    <span class="small text-muted">threshold: @hw.HeatWaveThreshold°F (90th percentile of historical Jun–Aug highs)</span>
                </div>
                <div class="row g-3">
                    @if (hw.HistoricalAvgDuration.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-danger">@hw.HistoricalAvgDuration.Value.ToString("F1")</div>
                                    <div class="small fw-semibold mt-1">Avg heat wave length</div>
                                    <div class="text-muted" style="font-size:.8rem">days (historical)</div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (hw.HistoricalAvgPeak.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-danger">@hw.HistoricalAvgPeak.Value.ToString("F0")°</div>
                                    <div class="small fw-semibold mt-1">Avg peak temp</div>
                                    <div class="text-muted" style="font-size:.8rem">during heat waves</div>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-6 col-md-3">
                        <div class="card border-0 h-100 bg-light">
                            <div class="card-body p-3">
                                <div class="stat-hero-temp" style="color:#7c3aed;">@hw.DangerousNightsThisYear</div>
                                <div class="small fw-semibold mt-1">Dangerous nights @currentYear</div>
                                <div class="text-muted" style="font-size:.8rem">Overnights ≥ 70°F</div>
                            </div>
                        </div>
                    </div>
                    @if (thisYearHwCount > 0 || hw.TopEvents.Count > 0)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-warning">@thisYearHwCount</div>
                                    <div class="small fw-semibold mt-1">Heat waves @currentYear</div>
                                    <div class="text-muted" style="font-size:.8rem">so far</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
            <hr class="section-divider" />
        }

        <!-- YTD Departure from Normal Chart -->
        @if (Model.YtdDepartures.Count > 10)
        {
            <section class="mb-4">
                <div class="d-flex align-items-baseline gap-3 mb-3">
                    <h2 class="h5 fw-bold mb-0">@currentYear Daily High Temperature vs Normal</h2>
                    <span class="small text-muted">Year to date</span>
                </div>
                <div class="card border-0 bg-light">
                    <div class="card-body py-3 px-3">
                        <div class="chart-container" style="height:240px;">
                            <canvas id="departureChart"></canvas>
                        </div>
                        <div class="d-flex gap-4 mt-2 justify-content-center small text-muted">
                            <span><span style="display:inline-block;width:12px;height:12px;background:#ef4444;border-radius:2px;"></span> Above normal</span>
                            <span><span style="display:inline-block;width:12px;height:12px;background:#3b82f6;border-radius:2px;"></span> Below normal</span>
                        </div>
                    </div>
                </div>
                @if (Model.NormalMaxTemp.HasValue)
                {
                    var aboveCount = Model.YtdDepartures.Count(d => d.Departure > 0);
                    var totalWithData = Model.YtdDepartures.Count(d => d.Departure.HasValue);
                    <p class="small text-muted mt-2 mb-0">
                        @aboveCount of @totalWithData days with data were above the 1991–2020 normal high for their date.
                    </p>
                }
            </section>
            <hr class="section-divider" />
        }

        <!-- 90°F Days Per Year Chart -->
        @if (Model.HotDaysPerYear.Count > 5)
        {
            var completeYears = Model.HotDaysPerYear.Where(x => x.Year < currentYear).ToList();
            var avgHotDays = completeYears.Count > 0 ? completeYears.Average(x => x.Count) : 0;
            var maxHotYear = completeYears.Count > 0
                ? completeYears.OrderByDescending(x => x.Count).First()
                : Model.HotDaysPerYear.OrderByDescending(x => x.Count).First();
            var thisYearEntry = Model.HotDaysPerYear.FirstOrDefault(x => x.Year == currentYear);
            var last10 = completeYears.TakeLast(10).ToList();
            var avg10 = last10.Count > 0 ? last10.Average(x => x.Count) : 0;
            <section class="mb-4">
                <div class="d-flex align-items-baseline gap-3 mb-3">
                    <h2 class="h5 fw-bold mb-0">Days ≥ 90°F Per Year</h2>
                    <span class="small text-muted">@Model.HotDaysPerYear.First().Year–@currentYear</span>
                </div>
                <div class="row g-3 mb-3">
                    @if (thisYearEntry.Year > 0)
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:#fefce8;border:1px solid #fde047;">
                                <div class="fw-bold fs-5" style="color:#854d0e;">@thisYearEntry.Count</div>
                                <div class="small text-muted">@currentYear so far</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fw-bold fs-5">@avgHotDays.ToString("F0")</div>
                                <div class="small text-muted">Avg/year 1970–@(currentYear-1)</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fw-bold fs-5">@avg10.ToString("F0")</div>
                                <div class="small text-muted">Avg/year (last 10 complete)</div>
                            </div>
                        </div>
                    }
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <div class="fw-bold fs-5 text-danger">@maxHotYear.Count</div>
                            <div class="small text-muted">Most in a year (@maxHotYear.Year)</div>
                        </div>
                    </div>
                </div>
                <div class="card border-0 bg-light">
                    <div class="card-body py-3 px-3">
                        <div class="chart-container">
                            <canvas id="hotDaysChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>
            <hr class="section-divider" />
        }

        <!-- Average Daily High by Decade -->
        @if (hw != null && hw.AvgHighByDecade.Count > 0)
        {
            <section class="mb-4">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-1">Average Daily High by Decade</h3>
                        <p class="text-muted small mb-3">Full year · complete decades only</p>
                        <div class="chart-container" style="height:220px;"><canvas id="avgHighDecadeChart"></canvas></div>
                    </div>
                </div>
            </section>
            <hr class="section-divider" />
        }

        <!-- Heat wave leaderboard -->
        @if (hw != null && hw.TopEvents.Count > 0)
        {
            <section class="mb-4">
                <h2 class="h5 fw-bold mb-3">Longest Heat Waves — @Model.Station.City</h2>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                        <thead class="table-danger">
                            <tr>
                                <th class="text-center" style="width:2.5rem">#</th>
                                <th>Dates</th>
                                <th class="text-center">Days</th>
                                <th class="text-center">Peak</th>
                                <th class="text-center">Avg High</th>
                                <th class="text-center">Avg Overnight Low</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < hw.TopEvents.Count; i++)
                            {
                                var ev = hw.TopEvents[i];
                                <tr class="@(i == 0 ? "fw-semibold" : "")">
                                    <td class="text-center text-muted small">@(i == 0 ? "🏆" : (i + 1).ToString())</td>
                                    <td class="small">@ev.FormattedStart – @ev.FormattedEnd</td>
                                    <td class="text-center">@ev.DurationDays</td>
                                    <td class="text-center text-danger">@ev.PeakTemp°F <span class="text-muted fw-normal small">(@ev.FormattedPeak)</span></td>
                                    <td class="text-center">@ev.AvgDailyMax.ToString("F0")°F</td>
                                    <td class="text-center text-muted">@ev.AvgOvernightLow.ToString("F0")°F</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <hr class="section-divider" />
        }

        <!-- Heat wave frequency chart -->
        @if (hw != null && hw.EventsPerYear.Count > 5)
        {
            <section class="mb-4">
                <h2 class="h5 fw-bold mb-3">Heat Waves Per Year</h2>
                <div class="card border-0 bg-light">
                    <div class="card-body py-3 px-3">
                        <div class="chart-container" style="height:220px;">
                            <canvas id="heatWaveFreqChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>
            <hr class="section-divider" />
        }

        <!-- Warm Summer Nights -->
        @if (wn != null && wn.WarmNightsPerYear.Count > 0)
        {
            <section class="mb-4">
                <div class="row mb-2 align-items-end">
                    <div class="col">
                        <h2 class="h5 fw-bold mb-0">Warm Summer Nights <span class="text-muted fw-normal">(Jun–Aug)</span></h2>
                        <p class="text-muted small mb-0">Nights where the overnight low exceeded the 1991–2020 normal low</p>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 h-100" style="background:#fffbea;">
                            <div class="card-body p-3">
                                <div class="stat-hero-temp" style="color:#d97706;">@wn.ThisSummerCount</div>
                                <div class="small fw-semibold mt-1">@currentYear @(isSummer ? "so far" : "total")</div>
                                <div class="text-muted" style="font-size:.8rem">above-normal nights</div>
                            </div>
                        </div>
                    </div>
                    @if (wn.HistoricalAvg.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-secondary">@wn.HistoricalAvg.Value.ToString("F1")</div>
                                    <div class="small fw-semibold mt-1">Avg / summer</div>
                                    <div class="text-muted" style="font-size:.8rem">1970–2020</div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (wn.RecordYear.HasValue && wn.RecordCount.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-danger">@wn.RecordCount</div>
                                    <div class="small fw-semibold mt-1">Most in a summer</div>
                                    <div class="text-muted" style="font-size:.8rem">@wn.RecordYear</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card border-0 bg-light mb-4">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-3">Above-Normal Summer Nights Per Year</h3>
                        <div class="chart-container"><canvas id="warmNightsChart"></canvas></div>
                    </div>
                </div>
                @if (wn.AvgLowByDecade.Count > 0)
                {
                    <div class="card border-0 bg-light mb-2">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold mb-1">Average June–August Low by Decade</h3>
                            <p class="text-muted small mb-3">Overnight lows · complete decades only</p>
                            <div class="chart-container" style="height:200px;"><canvas id="avgLowDecadeChart"></canvas></div>
                        </div>
                    </div>
                }
            </section>
        }

        </div>
        </div><!-- /#tab-heat -->
        }

        <!-- ══════════════════════════════════════════════════════════════════
             PRECIPITATION TAB
        ═══════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="tab-precipitation" role="tabpanel">
        @if (Model.Precip is not null)
        {
            var p = Model.Precip;
            var ytdDiff  = p.YtdActual - p.YtdNormal;
            var monDiff  = p.MonthFullNormal > 0 ? p.MonthActual - p.MonthFullNormal : (double?)null;
            var sumDiff  = p.SummerActual.HasValue && p.SummerFullNormal.HasValue
                           ? p.SummerActual.Value - p.SummerFullNormal.Value : (double?)null;
            static string DiffLabel(double d) => (d >= 0 ? "+" : "") + d.ToString("F2") + "\"";
            static string DiffCss(double d) => d >= 0.25 ? "primary" : d <= -0.25 ? "danger" : "secondary";

            <section class="mb-4 pt-3">
                <div class="row mb-3 align-items-end">
                    <div class="col">
                        <h2 class="h5 fw-bold mb-0">Precipitation</h2>
                        <p class="text-muted small mb-0">Actual vs. 1991–2020 full-month and full-season normals</p>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 h-100 bg-light">
                            <div class="card-body p-3">
                                <div class="stat-hero-temp text-primary">@p.YtdActual.ToString("F2")"</div>
                                <div class="small fw-semibold mt-1">@currentYear YTD</div>
                                <div class="text-muted" style="font-size:.8rem">Normal: @p.YtdNormal.ToString("F2")"</div>
                                <span class="badge bg-@DiffCss(ytdDiff) mt-1">@DiffLabel(ytdDiff)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 h-100 bg-light">
                            <div class="card-body p-3">
                                <div class="stat-hero-temp text-primary">@p.MonthActual.ToString("F2")"</div>
                                <div class="small fw-semibold mt-1">@monthName so far</div>
                                @if (p.MonthFullNormal > 0)
                                {
                                    <div class="text-muted" style="font-size:.8rem">@monthName normal: @p.MonthFullNormal.ToString("F2")"</div>
                                }
                                @if (monDiff.HasValue)
                                {
                                    <span class="badge bg-@DiffCss(monDiff.Value) mt-1">@DiffLabel(monDiff.Value)</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (p.SummerActual.HasValue && p.SummerFullNormal.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-primary">@p.SummerActual.Value.ToString("F2")"</div>
                                    <div class="small fw-semibold mt-1">Summer so far</div>
                                    <div class="text-muted" style="font-size:.8rem">Summer normal: @p.SummerFullNormal.Value.ToString("F2")"</div>
                                    @if (sumDiff.HasValue)
                                    {
                                        <span class="badge bg-@DiffCss(sumDiff.Value) mt-1">@DiffLabel(sumDiff.Value)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-6 col-md-3">
                        <div class="card border-0 h-100 bg-light">
                            <div class="card-body p-3">
                                <div class="stat-hero-temp text-secondary">@p.CurrentYearHeavyDays</div>
                                <div class="small fw-semibold mt-1">@currentYear heavy rain days</div>
                                <div class="text-muted" style="font-size:.8rem">Days with ≥ 1.0"</div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (p.YtdCumulative.Count > 5)
                {
                    var standing = p.YtdActual - p.YtdNormal;
                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold mb-1">@currentYear Accumulation vs. Normal</h3>
                            <p class="text-muted small mb-3">
                                Running total since Jan 1 against the normal pace for the same date &middot;
                                @if (Math.Abs(standing) < 0.05)
                                {
                                    <text>@Model.Station.City is running right at normal</text>
                                }
                                else
                                {
                                    <text>
                                        @Model.Station.City is
                                        <strong class="text-@(standing >= 0 ? "primary" : "danger")">
                                            @Math.Abs(standing).ToString("F2")" @(standing >= 0 ? "ahead of" : "behind")
                                        </strong>
                                        the normal pace
                                    </text>
                                }
                            </p>
                            <div class="chart-container"><canvas id="precipAccumChart"></canvas></div>
                        </div>
                    </div>
                }
                <div class="card border-0 bg-light mb-4">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-1">Monthly Precipitation — Last 24 Months</h3>
                        <p class="text-muted small mb-3">Blue = actual · dashed line = monthly normal</p>
                        <div class="chart-container" style="height:220px;"><canvas id="precipMonthlyChart"></canvas></div>
                    </div>
                </div>
                <div class="card border-0 bg-light mb-4">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-1">
                            Annual Precipitation Per Year@(precipFirstYear.HasValue ? $" ({precipFirstYear}–{currentYear})" : "")
                        </h3>
                        <p class="text-muted small mb-3">
                            Blue = above average · tan = below average · gold = @currentYear (partial)
                            @if (precipAnnualTrend is { } atr && !atr.IsFlat(0.01))
                            {
                                <text>
                                    <br />
                                    Since @atr.FirstYear, annual totals have trended
                                    <strong>@atr.PerDecadeDisplay()" per decade</strong>,
                                    about @((atr.TotalChange >= 0 ? "+" : "") + atr.TotalChange.ToString("F1"))"
                                    across the record.
                                </text>
                            }
                        </p>
                        <div class="chart-container"><canvas id="precipAnnualChart"></canvas></div>
                    </div>
                </div>
                <div class="card border-0 bg-light mb-2">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-1">Heavy Rain Days Per Year (≥ 1.0")</h3>
                        <p class="text-muted small mb-3">Compare year-to-year changes in days with heavy rainfall (≥ 1.0")</p>
                        <div class="chart-container" style="height:220px;"><canvas id="precipHeavyChart"></canvas></div>
                    </div>
                </div>
            </section>
        }
        </div><!-- /#tab-precipitation -->

        <!-- ══════════════════════════════════════════════════════════════════
             MONTH IN REVIEW TAB
        ═══════════════════════════════════════════════════════════════════ -->
        @if (mr is not null)
        {
            <div class="tab-pane fade" id="tab-month" role="tabpanel">

            <!-- Headline -->
            <section class="mb-4 pt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <p class="text-uppercase fw-semibold text-muted small mb-0">
                        Month in Review — <strong class="text-dark">@mr.Label</strong>
                    </p>
                    <form method="get" action="/stations/@Model.Station.Slug"
                          class="d-flex align-items-end gap-2" id="monthPickerForm">
                        <div>
                            <label for="pickMonth" class="form-label small text-muted mb-1">Month</label>
                            <select class="form-select form-select-sm" id="pickMonth" name="month">
                                @for (var i = 1; i <= 12; i++)
                                {
                                    if (!mr.AvailableYearsByMonth.ContainsKey(i)) { continue; }
                                    <option value="@i" selected="@(i == mr.Month)">
                                        @(new DateTime(2000, i, 1).ToString("MMMM"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="pickYear" class="form-label small text-muted mb-1">Year</label>
                            <select class="form-select form-select-sm" id="pickYear" name="year">
                                @foreach (var y in mr.AvailableYearsByMonth.GetValueOrDefault(mr.Month) ?? [])
                                {
                                    <option value="@y" selected="@(y == mr.Year)">@y</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">View</button>
                        @if (!mr.IsLatest)
                        {
                            <a href="/stations/@Model.Station.Slug" class="btn btn-sm btn-outline-secondary">Latest</a>
                        }
                    </form>
                </div>

                @if (Model.MonthRequestUnavailable)
                {
                    <div class="alert alert-warning py-2 small">
                        That month has no complete record at this station. Showing @mr.Label instead.
                    </div>
                }
                <div class="card border-0 @(mr.IsNotableAllTime ? "bg-danger bg-opacity-10" : "bg-light")">
                    <div class="card-body text-center py-4">
                        <div class="stat-hero-temp @(mr.IsNotableAllTime ? "text-danger" : "")">@mr.AvgTempDisplay°F</div>
                        <p class="text-muted mt-2 mb-2 small">Average temperature &middot; @mr.Label</p>
                        <p class="h5 fw-bold mb-2 @(mr.IsNotableAllTime ? "text-danger" : "")">
                            @mr.RankAllMonthsOrdinal-warmest month on record
                        </p>
                        <p class="small text-muted mb-2">
                            @mr.RankSameMonthOrdinal-warmest @mr.MonthName of @mr.TotalSameMonths on record
                        </p>
                        @if (mr.DepartureFromNormal.HasValue)
                        {
                            var dep = mr.DepartureFromNormal.Value;
                            <span class="badge @(dep >= 0 ? "bg-danger" : "bg-primary") bg-opacity-10 @(dep >= 0 ? "text-danger" : "text-primary") normal-badge">
                                @mr.DepartureDisplay° vs. @mr.NormalAvgDisplay° average (1991–2020)
                            </span>
                        }
                    </div>
                </div>
            </section>

            <!-- Key stats -->
            <section class="mb-4">
                <div class="row g-3">
                    @if (mr.WarmestMonthEver is not null)
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:#fff5f5;border:1px solid #fecaca;">
                                <div class="fw-bold fs-5 text-danger">@mr.WarmestMonthEver.Display°F</div>
                                <div class="small text-muted mt-1">Warmest month ever</div>
                                <div class="small text-muted">@mr.WarmestMonthEver.Label</div>
                            </div>
                        </div>
                    }
                    @if (mr.WarmestSameMonthEver is not null)
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fw-bold fs-5">@mr.WarmestSameMonthEver.Display°F</div>
                                <div class="small text-muted mt-1">Warmest @mr.MonthName ever</div>
                                <div class="small text-muted">@mr.WarmestSameMonthEver.Year</div>
                            </div>
                        </div>
                    }
                    @if (mr.ShowStreak)
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fw-bold fs-5">@mr.HotDaysInMonth</div>
                                <div class="small text-muted mt-1">Days ≥ @mr.HotDayThreshold°F</div>
                                <div class="small text-muted">in @mr.MonthName</div>
                            </div>
                        </div>
                    }
                    @if (mr.YearPeakHigh.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 rounded" style="background:#fefce8;border:1px solid #fde047;">
                                <div class="fw-bold fs-5" style="color:#854d0e;">@mr.YearPeakHigh°F</div>
                                <div class="small text-muted mt-1">Hottest of @mr.Year</div>
                                @if (mr.YearPeakHighDate is not null && DateTime.TryParse(mr.YearPeakHighDate, out var pk))
                                {
                                    <div class="small text-muted">@pk.ToString("MMM d")</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Streak + milestone callouts -->
            @if (mr.ShowStreak && mr.LongestStreakInMonth is not null)
            {
                var streak = mr.LongestStreakInMonth;
                <section class="mb-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold mb-2">Longest @mr.HotDayThreshold°F Streak in @mr.MonthName</h3>
                            <p class="mb-2">
                                <strong class="fs-5">@streak.Days consecutive @TodaysRecordHigh.Web.Models.MonthInReview.Pluralize(streak.Days, "day")</strong>
                                with highs of at least @mr.HotDayThreshold°F
                                <span class="text-muted">(@streak.FormattedRange, peaking at @streak.PeakTemp°F)</span>
                            </p>
                            @if (mr.StreakIsMonthRecord)
                            {
                                <p class="small text-danger fw-semibold mb-0">
                                    The longest @mr.MonthName streak in @Model.Station.City&rsquo;s recorded history.
                                </p>
                            }
                            else if (mr.LastYearTiedStreak.HasValue
                                     && (!mr.LastYearWithLongerStreak.HasValue
                                         || mr.LastYearTiedStreak > mr.LastYearWithLongerStreak))
                            {
                                <p class="small text-muted mb-0">
                                    Ties the longest @mr.MonthName streak since <strong>@mr.LastYearTiedStreak</strong>
                                    (@mr.YearsSinceTiedStreak @TodaysRecordHigh.Web.Models.MonthInReview.Pluralize(mr.YearsSinceTiedStreak!.Value, "year")).
                                    @if (mr.LongestStreakEver is not null && mr.LongestStreakEver.Days > streak.Days)
                                    {
                                        <text>The @mr.MonthName record is @mr.LongestStreakEver.Days days, set in @mr.LongestStreakEver.Year.</text>
                                    }
                                </p>
                            }
                            else if (mr.LastYearWithLongerStreak.HasValue)
                            {
                                <p class="small text-muted mb-0">
                                    The longest @mr.MonthName streak since <strong>@mr.LastYearWithLongerStreak</strong>
                                    (@mr.YearsSinceLongerStreak @TodaysRecordHigh.Web.Models.MonthInReview.Pluralize(mr.YearsSinceLongerStreak!.Value, "year")).
                                    @if (mr.LongestStreakEver is not null)
                                    {
                                        <text>The @mr.MonthName record is @mr.LongestStreakEver.Days days, set in @mr.LongestStreakEver.Year.</text>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                </section>
            }

            @* Only worth a callout when the milestone is genuinely infrequent — in Phoenix,
               "first time since last year" is noise. *@
            @if (mr.PeakMilestone.HasValue && mr.YearPeakHigh.HasValue
                 && (!mr.LastYearAtMilestone.HasValue || mr.YearsSinceMilestone >= 3))
            {
                <section class="mb-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold mb-2">@mr.PeakMilestone°F Milestone</h3>
                            @if (mr.LastYearAtMilestone.HasValue)
                            {
                                <p class="small text-muted mb-0">
                                    @Model.Station.City reached <strong>@mr.YearPeakHigh°F</strong> in @mr.Year —
                                    the first time it hit @mr.PeakMilestone°F since
                                    <strong>@mr.LastYearAtMilestone</strong>
                                    (@mr.YearsSinceMilestone @TodaysRecordHigh.Web.Models.MonthInReview.Pluralize(mr.YearsSinceMilestone!.Value, "year")).
                                </p>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">
                                    @Model.Station.City reached <strong>@mr.YearPeakHigh°F</strong> in @mr.Year —
                                    the first time it has ever hit @mr.PeakMilestone°F on record.
                                </p>
                            }
                        </div>
                    </div>
                </section>
            }

            <hr class="section-divider" />

            <!-- Every year's average for this calendar month -->
            @if (mr.SameMonthHistory.Count > 3)
            {
                <section class="mb-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold mb-1">Average @mr.MonthName Temperature by Year</h3>
                            <p class="text-muted small mb-3">
                                @mr.SameMonthHistory.First().Year–@mr.SameMonthHistory.Last().Year &middot;
                                @mr.Year highlighted
                                @if (mr.SameMonthTrend is { } ttr && !ttr.IsFlat(0.05))
                                {
                                    <text>
                                        &middot; trend @ttr.PerDecadeDisplay("F2")° per decade
                                        (@(ttr.PerDecade >= 0 ? "warming" : "cooling") since @ttr.FirstYear)
                                    </text>
                                }
                            </p>
                            <div class="chart-container"><canvas id="monthHistoryChart"></canvas></div>
                        </div>
                    </div>
                </section>
                <hr class="section-divider" />
            }

            <!-- Precipitation for the month -->
            @if (mp is not null)
            {
                var wetCss = mp.IsWetterThanNormal ? "primary" : "danger";
                <section class="mb-4">
                    <h2 class="h6 fw-bold mb-1">Precipitation — @mp.Label</h2>
                    <p class="text-muted small mb-3">
                        Month total against the 1991–2020 average and every other @mp.MonthName on record
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    <div class="stat-hero-temp text-@wetCss">@mp.TotalDisplay"</div>
                                    <div class="small fw-semibold mt-1">Total precipitation</div>
                                    <div class="text-muted" style="font-size:.8rem">@mp.Label</div>
                                </div>
                            </div>
                        </div>
                        @if (mp.NormalTotal.HasValue)
                        {
                            <div class="col-6 col-md-3">
                                <div class="card border-0 h-100 bg-light">
                                    <div class="card-body p-3">
                                        <div class="fw-bold fs-5 text-@wetCss">@mp.DepartureDisplay"</div>
                                        <div class="small fw-semibold mt-1">vs. average</div>
                                        <div class="text-muted" style="font-size:.8rem">
                                            Normal: @mp.NormalDisplay"
                                            @if (mp.PercentOfNormal.HasValue)
                                            {
                                                <text>&middot; @mp.PercentOfNormal% of normal</text>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 @(mp.IsNotableWet || mp.IsNotableDry ? "bg-warning bg-opacity-25" : "bg-light")">
                                <div class="card-body p-3">
                                    <div class="fw-bold fs-5">@mp.RankOrdinal-@mp.RankSuperlative</div>
                                    <div class="small fw-semibold mt-1">@mp.MonthName rank</div>
                                    <div class="text-muted" style="font-size:.8rem">
                                        of @mp.TotalSameMonths on record
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 h-100 bg-light">
                                <div class="card-body p-3">
                                    @if (mp.WettestSameMonthEver is not null)
                                    {
                                        <div class="fw-bold fs-5 text-primary">@mp.WettestSameMonthEver.Display"</div>
                                        <div class="small fw-semibold mt-1">Wettest @mp.MonthName ever</div>
                                        <div class="text-muted" style="font-size:.8rem">
                                            @mp.WettestSameMonthEver.Year
                                            @if (mp.DriestSameMonthEver is not null)
                                            {
                                                <text>&middot; driest @mp.DriestSameMonthEver.Display" (@mp.DriestSameMonthEver.Year)</text>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (mp.SameMonthHistory.Count > 3)
                    {
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <h3 class="h6 fw-semibold mb-1">@mp.MonthName Precipitation by Year</h3>
                                <p class="text-muted small mb-3">
                                    @mp.SameMonthHistory.First().Year–@mp.SameMonthHistory.Last().Year &middot;
                                    @mp.Year highlighted
                                    @if (mp.SameMonthTrend is { } ptr && !ptr.IsFlat(0.005))
                                    {
                                        <text>
                                            &middot; trend @ptr.PerDecadeDisplay()" per decade
                                            (@(ptr.PerDecade >= 0 ? "wetter" : "drier") since @ptr.FirstYear)
                                        </text>
                                    }
                                </p>
                                <div class="chart-container"><canvas id="monthPrecipChart"></canvas></div>
                            </div>
                        </div>
                    }

                    @if (mp.TopSameMonths.Count > 1)
                    {
                        <div class="row g-4 mt-1">
                            <div class="col-lg-6">
                                <h3 class="h6 fw-bold mb-3">Wettest @(mp.MonthName)s on Record</h3>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                        <thead class="table-primary">
                                            <tr>
                                                <th class="text-center" style="width:2.5rem">#</th>
                                                <th>Year</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @for (var i = 0; i < mp.TopSameMonths.Count; i++)
                                        {
                                            var w = mp.TopSameMonths[i];
                                            <tr class="@(w.Year == mp.Year ? "table-warning fw-semibold" : "")">
                                                <td class="text-center text-muted">@(i + 1)</td>
                                                <td>@w.Year</td>
                                                <td class="text-end">@w.Display"</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <h3 class="h6 fw-bold mb-3">Driest @(mp.MonthName)s on Record</h3>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                        <thead style="background:#efe6d5;">
                                            <tr>
                                                <th class="text-center" style="width:2.5rem">#</th>
                                                <th>Year</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @for (var i = 0; i < mp.DriestSameMonths.Count; i++)
                                        {
                                            var d = mp.DriestSameMonths[i];
                                            <tr class="@(d.Year == mp.Year ? "table-warning fw-semibold" : "")">
                                                <td class="text-center text-muted">@(i + 1)</td>
                                                <td>@d.Year</td>
                                                <td class="text-end">@d.Display"</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </section>
                <hr class="section-divider" />
            }

            <!-- Warmest months leaderboards -->
            <section class="mb-4">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h2 class="h6 fw-bold mb-3">Warmest @(mr.MonthName)s on Record</h2>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                <thead class="table-danger">
                                    <tr>
                                        <th class="text-center" style="width:2.5rem">#</th>
                                        <th>Year</th>
                                        <th class="text-end">Avg Temp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < mr.TopSameMonths.Count; i++)
                                {
                                    var m = mr.TopSameMonths[i];
                                    var isTarget = m.Year == mr.Year;
                                    <tr class="@(isTarget ? "table-warning fw-semibold" : "")">
                                        <td class="text-center text-muted">@(i + 1)</td>
                                        <td>@m.Year</td>
                                        <td class="text-end">@m.Display°F</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h2 class="h6 fw-bold mb-3">Warmest Months on Record (Any Month)</h2>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                <thead class="table-danger">
                                    <tr>
                                        <th class="text-center" style="width:2.5rem">#</th>
                                        <th>Month</th>
                                        <th class="text-end">Avg Temp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < mr.TopMonths.Count; i++)
                                {
                                    var m = mr.TopMonths[i];
                                    var isTarget = m.Year == mr.Year && m.Month == mr.Month;
                                    <tr class="@(isTarget ? "table-warning fw-semibold" : "")">
                                        <td class="text-center text-muted">@(i + 1)</td>
                                        <td>@m.Label</td>
                                        <td class="text-end">@m.Display°F</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Regional context -->
            @if (mr.Peers.Count > 0)
            {
                <hr class="section-divider" />
                <section class="mb-4">
                    <h2 class="h6 fw-bold mb-1">Nearby Stations — @mr.Label</h2>
                    <p class="text-muted small mb-3">How the same month ranked at the closest reporting stations</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Station</th>
                                    <th class="text-end">Avg Temp</th>
                                    <th class="text-end">@mr.MonthName Rank</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-warning fw-semibold">
                                    <td>@Model.Station.City, @Model.Station.State</td>
                                    <td class="text-end">@mr.AvgTempDisplay°F</td>
                                    <td class="text-end">@mr.RankSameMonthOrdinal of @mr.TotalSameMonths</td>
                                </tr>
                            @foreach (var p in mr.Peers)
                            {
                                <tr>
                                    <td><a href="/stations/@p.Slug">@p.City, @p.State</a></td>
                                    <td class="text-end">@p.Display°F</td>
                                    <td class="text-end">
                                        @p.RankOrdinal of @p.TotalSameMonths
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            <section class="p-4 bg-light rounded small text-muted mt-2">
                <strong>About this data.</strong> Monthly averages are the mean of daily average temperatures,
                computed from NOAA Threadex records via RCC ACIS. Months missing more than three days of
                observations are excluded from the rankings, so the in-progress month never appears.
                Rankings cover @(mr.TotalMonths.ToString("N0")) complete months on record.
                @if (mp is not null)
                {
                    <text>
                        Precipitation totals sum the daily reports for the month, with trace amounts counted
                        as zero. A month missing any day of precipitation data is left out entirely
                        (an unreported day is unreported rain), so the precipitation ranking covers
                        @mp.TotalSameMonths complete @(mp.MonthName)s. Normals are the 1991–2020 mean for the
                        same calendar month. Trend lines are a least-squares fit across every year shown.
                    </text>
                }
            </section>

            </div><!-- /#tab-month -->
        }

        </div><!-- /.tab-content -->
    }

    <div class="mt-4">
        <a href="/" class="btn btn-outline-secondary btn-sm">&larr; Back to all stations</a>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    Chart.defaults.font.family = '-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif';
    Chart.defaults.font.size = 12;

    // ── Lazy-init: all charts are in non-default tabs ───────────────────
    let heatInited   = false;
    let precipInited = false;
    let monthInited  = false;

    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn => {
        btn.addEventListener('shown.bs.tab', e => {
            const target = e.target.getAttribute('data-bs-target');
            if (target === '#tab-heat'          && !heatInited)   { heatInited   = true; initHeatCharts(); }
            if (target === '#tab-precipitation' && !precipInited) { precipInited = true; initPrecipCharts(); }
            if (target === '#tab-month'         && !monthInited)  { monthInited  = true; initMonthChart(); }
        });
    });

    // ── Month picker ─────────────────────────────────────────────────────
    // The month under review is a round trip, so the picker rewrites its own year
    // list from the station's record and the page comes back on the same tab.
    (function initMonthPicker() {
        const form = document.getElementById('monthPickerForm');
        if (!form) return;

        const yearsByMonth = @Html.Raw(availableYearsJson);
        const monthSel = document.getElementById('pickMonth');
        const yearSel  = document.getElementById('pickYear');

        monthSel.addEventListener('change', () => {
            const years = yearsByMonth[monthSel.value] || [];
            const wanted = yearSel.value;
            yearSel.innerHTML = '';
            for (const y of years) {
                const opt = document.createElement('option');
                opt.value = y;
                opt.textContent = y;
                yearSel.appendChild(opt);
            }
            // Keep the year the reader was already looking at where that month has one.
            yearSel.value = years.includes(Number(wanted)) ? wanted : (years[0] ?? '');
        });
    })();

    // A month picked from the query string belongs on the Month in Review tab.
    (function openRequestedTab() {
        const params = new URLSearchParams(window.location.search);
        if (!params.has('month')) return;
        const btn = document.querySelector('[data-bs-target="#tab-month"]');
        if (btn && window.bootstrap) bootstrap.Tab.getOrCreateInstance(btn).show();
    })();

    // ── Month in Review ──────────────────────────────────────────────────
    function initMonthChart() {
        const monthData      = @Html.Raw(monthHistoryJson);
        const monthNormal    = @Html.Raw(monthNormalJson);
        const monthTempTrend = @Html.Raw(monthTempTrendJson);
        const targetYear     = @(mr?.Year ?? 0);

        initMonthPrecipChart(targetYear);

        const ctx = document.getElementById('monthHistoryChart');
        if (!ctx || !monthData.length) return;

        const temps  = monthData.map(d => d.avg);
        const minT   = Math.min(...temps), maxT = Math.max(...temps);
        const colors = monthData.map(d => {
            if (d.year === targetYear) return 'rgba(234,179,8,0.95)';
            // Cool blue → hot red across the station's own range for this month
            const t = (d.avg - minT) / Math.max(maxT - minT, 0.1);
            const r = Math.round(59  + t * 180);
            const g = Math.round(130 - t * 80);
            const b = Math.round(246 - t * 190);
            return `rgba(${r},${g},${b},0.8)`;
        });

        const datasets = [{
            type: 'bar',
            label: 'Average temperature (°F)',
            data: temps,
            backgroundColor: colors,
            borderWidth: 0,
            borderRadius: 2,
            order: 2
        }];

        if (monthNormal !== null) {
            datasets.push({
                type: 'line',
                label: '1991–2020 average',
                data: monthData.map(() => monthNormal),
                borderColor: 'rgba(15,23,42,0.55)',
                borderDash: [6, 4],
                borderWidth: 1.5,
                pointRadius: 0,
                fill: false,
                order: 1
            });
        }

        if (monthTempTrend) {
            datasets.push(trendDataset(monthData, monthTempTrend, 'Trend', 'rgba(220,38,38,0.9)'));
        }

        new Chart(ctx, {
            data: { labels: monthData.map(d => d.year), datasets },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: datasets.length > 1,
                        labels: { boxWidth: 12, filter: i => i.datasetIndex > 0 }
                    },
                    tooltip: {
                        callbacks: {
                            label: (item) => {
                                // Reference lines identify themselves; only the bars get a departure.
                                if (item.dataset.type === 'line')
                                    return `${item.dataset.label}: ${item.parsed.y.toFixed(1)}°F`;
                                const d = monthData[item.dataIndex];
                                const lines = [`Average: ${d.avg.toFixed(1)}°F`];
                                if (monthNormal !== null) {
                                    const dep = d.avg - monthNormal;
                                    lines.push(`${dep >= 0 ? '+' : ''}${dep.toFixed(1)}°F vs. average`);
                                }
                                return lines;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 16 } },
                    y: {
                        grid: { color: 'rgba(0,0,0,0.06)' },
                        ticks: { callback: v => v + '°' },
                        // Bars start well below the data so year-to-year differences stay legible
                        min: Math.floor((minT - 2) / 5) * 5
                    }
                }
            }
        });
    }

    // A fitted line the server computed — drawn across the same year axis as the bars.
    function trendDataset(rows, trend, label, color) {
        return {
            type: 'line',
            label: label,
            data: rows.map(d => trend.intercept + trend.perYear * d.year),
            borderColor: color,
            borderWidth: 2,
            pointRadius: 0,
            fill: false,
            order: 0
        };
    }

    // Every year's total for the month under review, against its own normal and trend.
    function initMonthPrecipChart(targetYear) {
        const precipData   = @Html.Raw(monthPrecipJson);
        const precipNormal = @Html.Raw(monthPrecipNormalJson);
        const precipTrend  = @Html.Raw(monthPrecipTrendJson);
        const ctx = document.getElementById('monthPrecipChart');
        if (!ctx || !precipData.length) return;

        const totals = precipData.map(d => d.total);
        const maxP   = Math.max(...totals);

        // Wet years read blue, dry years tan, against the normal where there is one.
        const midpoint = precipNormal !== null ? precipNormal : maxP / 2;
        const colors = precipData.map(d => {
            if (d.year === targetYear) return 'rgba(234,179,8,0.95)';
            return d.total >= midpoint ? 'rgba(37,99,235,0.75)' : 'rgba(180,140,90,0.7)';
        });

        const datasets = [{
            type: 'bar',
            label: 'Precipitation (in)',
            data: totals,
            backgroundColor: colors,
            borderWidth: 0,
            borderRadius: 2,
            order: 2
        }];

        if (precipNormal !== null) {
            datasets.push({
                type: 'line',
                label: '1991–2020 average',
                data: precipData.map(() => precipNormal),
                borderColor: 'rgba(15,23,42,0.55)',
                borderDash: [6, 4],
                borderWidth: 1.5,
                pointRadius: 0,
                fill: false,
                order: 1
            });
        }

        if (precipTrend) {
            datasets.push(trendDataset(precipData, precipTrend, 'Trend', 'rgba(13,110,253,0.9)'));
        }

        new Chart(ctx, {
            data: { labels: precipData.map(d => d.year), datasets },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: datasets.length > 1,
                        labels: { boxWidth: 12, filter: i => i.datasetIndex > 0 }
                    },
                    tooltip: {
                        callbacks: {
                            label: (item) => {
                                if (item.dataset.type === 'line')
                                    return `${item.dataset.label}: ${item.parsed.y.toFixed(2)}"`;
                                const d = precipData[item.dataIndex];
                                const lines = [`Total: ${d.total.toFixed(2)}"`];
                                if (precipNormal !== null) {
                                    const dep = d.total - precipNormal;
                                    lines.push(`${dep >= 0 ? '+' : ''}${dep.toFixed(2)}" vs. average`);
                                    if (precipNormal > 0)
                                        lines.push(`${Math.round(d.total / precipNormal * 100)}% of normal`);
                                }
                                return lines;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 16 } },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.06)' },
                        ticks: { callback: v => v + '"' }
                    }
                }
            }
        });
    }

    // ── Heat Charts ──────────────────────────────────────────────────────
    function initHeatCharts() {

    // YTD Departure from Normal
    const ytdData = @Html.Raw(ytdJson);
    const deptCtx = document.getElementById('departureChart');
    if (deptCtx && ytdData.length > 0) {
        const labels = ytdData.map(d => {
            const dt = new Date(d.date + 'T00:00:00');
            return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });
        const step = Math.max(1, Math.floor(ytdData.length / 18));
        const filteredLabels = labels.map((l, i) => i % step === 0 ? l : '');
        new Chart(deptCtx, {
            type: 'bar',
            data: {
                labels: filteredLabels,
                datasets: [{
                    label: 'Departure from Normal (°F)',
                    data: ytdData.map(d => d.departure),
                    backgroundColor: ytdData.map(d =>
                        d.departure > 0 ? 'rgba(239,68,68,0.75)' : 'rgba(59,130,246,0.75)'
                    ),
                    borderWidth: 0, borderRadius: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: (items) => {
                                const d = ytdData[items[0].dataIndex];
                                return new Date(d.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
                            },
                            label: (item) => {
                                const d = ytdData[item.dataIndex];
                                const lines = [];
                                if (d.actual != null) lines.push(`Actual: ${d.actual}°F`);
                                if (d.normal != null) lines.push(`Normal: ${d.normal}°F`);
                                if (d.departure != null) {
                                    const sign = d.departure >= 0 ? '+' : '';
                                    lines.push(`Departure: ${sign}${d.departure.toFixed(1)}°F`);
                                }
                                return lines;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0 } },
                    y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => (v >= 0 ? '+' : '') + v + '°' } }
                }
            }
        });
    }

    // 90°F Days Per Year
    const hotData = @Html.Raw(hotDaysJson);
    const currentYear = @currentYear;
    const hotCtx = document.getElementById('hotDaysChart');
    if (hotCtx && hotData.length > 0) {
        const completeYears = hotData.filter(d => d.year < currentYear);
        const avg = completeYears.length
            ? completeYears.reduce((s, d) => s + d.count, 0) / completeYears.length
            : hotData.reduce((s, d) => s + d.count, 0) / hotData.length;
        const minYear = hotData[0].year, maxYear = hotData[hotData.length - 1].year;
        const colors = hotData.map(d => {
            if (d.year === currentYear) return 'rgba(234,179,8,0.85)';
            const t = (d.year - minYear) / Math.max(maxYear - minYear, 1);
            const r = Math.round(180 + t * 75), g = Math.round(120 - t * 70);
            return `rgba(${r},${g},60,0.8)`;
        });
        new Chart(hotCtx, {
            type: 'bar',
            data: {
                labels: hotData.map(d => d.year),
                datasets: [
                    { label: 'Days ≥ 90°F', data: hotData.map(d => d.count), backgroundColor: colors, borderWidth: 0, borderRadius: 2, order: 2 },
                    { label: `Avg 1970–${currentYear - 1} (${avg.toFixed(0)} days)`, data: hotData.map(() => avg), type: 'line', borderColor: 'rgba(0,0,0,0.4)', borderWidth: 1.5, borderDash: [4,4], pointRadius: 0, fill: false, order: 1 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 16 } },
                    tooltip: {
                        callbacks: {
                            title: (items) => { const d = hotData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (through yesterday)` : String(d.year); },
                            label: (item) => item.dataset.type === 'line' ? `Avg (complete years): ${avg.toFixed(1)} days` : `${item.raw} days ≥ 90°F`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? hotData[i]?.year : '' } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { stepSize: 10 } }
                }
            }
        });
    }

    // Warm Nights Per Year
    const wnData = @Html.Raw(warmNightsJson);
    const wnHistAvg = @Html.Raw(warmNightsHistAvg);
    const wnCtx = document.getElementById('warmNightsChart');
    if (wnCtx && wnData.length > 0) {
        new Chart(wnCtx, {
            type: 'bar',
            data: {
                labels: wnData.map(d => d.year),
                datasets: [
                    {
                        label: 'Above-normal nights',
                        data: wnData.map(d => d.count),
                        backgroundColor: wnData.map(d => d.year === currentYear ? 'rgba(234,179,8,0.85)' : 'rgba(109,40,217,0.65)'),
                        borderWidth: 0, borderRadius: 2, order: 2
                    },
                    ...(wnHistAvg != null ? [{
                        label: `Avg 1970–2020 (${parseFloat(wnHistAvg).toFixed(1)} nights)`,
                        data: wnData.map(() => wnHistAvg),
                        type: 'line', borderColor: 'rgba(0,0,0,0.4)', borderWidth: 1.5, borderDash: [4,4], pointRadius: 0, fill: false, order: 1
                    }] : [])
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 16 } },
                    tooltip: {
                        callbacks: {
                            title: (items) => { const d = wnData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (through yesterday)` : String(d.year); },
                            label: (item) => item.dataset.type === 'line' ? `Avg (1970–2020): ${parseFloat(wnHistAvg).toFixed(1)} nights` : `${item.raw} above-normal nights`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? wnData[i]?.year : '' } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, title: { display: true, text: 'Nights above normal' } }
                }
            }
        });
    }

    // Helper: color bars by actual value (coldest=blue, hottest=red)
    function tempColors(vals) {
        const lo = Math.min(...vals), hi = Math.max(...vals), rng = hi - lo;
        return vals.map(v => {
            const p = rng > 0 ? (v - lo) / rng : 0.5;
            const r = Math.round(96  + p * (220 - 96));
            const g = Math.round(165 - p * (165 - 38));
            const b = Math.round(250 - p * (250 - 38));
            return `rgba(${r},${g},${b},0.85)`;
        });
    }

    // Avg Daily High by Decade
    const avgHighDecadeData = @Html.Raw(avgHighDecadeJson);
    const avgHighDecadeCtx = document.getElementById('avgHighDecadeChart');
    if (avgHighDecadeCtx && avgHighDecadeData.length > 0) {
        new Chart(avgHighDecadeCtx, {
            type: 'bar',
            data: { labels: avgHighDecadeData.map(d => d.label), datasets: [{ data: avgHighDecadeData.map(d => d.avgHigh), backgroundColor: tempColors(avgHighDecadeData.map(d => d.avgHigh)), borderWidth: 0, borderRadius: 4 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: item => `Avg daily high: ${item.raw}°F` } } },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => v + '°F' } }
                }
            }
        });
    }

    // Avg Jun–Aug Low by Decade
    const decadeData = @Html.Raw(decadeJson);
    const decadeCtx = document.getElementById('avgLowDecadeChart');
    if (decadeCtx && decadeData.length > 0) {
        new Chart(decadeCtx, {
            type: 'bar',
            data: { labels: decadeData.map(d => d.label), datasets: [{ data: decadeData.map(d => d.avgLow), backgroundColor: tempColors(decadeData.map(d => d.avgLow)), borderWidth: 0, borderRadius: 4 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: item => `Avg Jun–Aug low: ${item.raw}°F` } } },
                scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => v + '°F' } } }
            }
        });
    }

    // Heat wave frequency per year
    const hwFreqData = @Html.Raw(heatWaveFreqJson);
    const hwFreqCtx = document.getElementById('heatWaveFreqChart');
    if (hwFreqCtx && hwFreqData.length > 0) {
        const hwCompleteYears = hwFreqData.filter(d => d.year < currentYear);
        const hwAvg = hwCompleteYears.length ? hwCompleteYears.reduce((s, d) => s + d.count, 0) / hwCompleteYears.length : null;
        new Chart(hwFreqCtx, {
            type: 'bar',
            data: {
                labels: hwFreqData.map(d => d.year),
                datasets: [
                    { label: 'Heat waves', data: hwFreqData.map(d => d.count), backgroundColor: hwFreqData.map(d => d.year === currentYear ? 'rgba(234,179,8,0.85)' : 'rgba(220,38,38,0.65)'), borderWidth: 0, borderRadius: 2, order: 2 },
                    ...(hwAvg != null ? [{ label: `Avg ${hwAvg.toFixed(1)}/year`, data: hwFreqData.map(() => hwAvg), type: 'line', borderColor: 'rgba(0,0,0,0.4)', borderWidth: 1.5, borderDash: [4,4], pointRadius: 0, fill: false, order: 1 }] : [])
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: hwAvg != null, position: 'top', labels: { boxWidth: 12, padding: 16 } },
                    tooltip: {
                        callbacks: {
                            title: (items) => { const d = hwFreqData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (through yesterday)` : String(d.year); },
                            label: (item) => item.dataset.type === 'line' ? `Avg: ${hwAvg?.toFixed(1)} heat waves/year` : `${item.raw} heat wave${item.raw !== 1 ? 's' : ''}`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? hwFreqData[i]?.year : '' } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { stepSize: 1 } }
                }
            }
        });
    }

    } // end initHeatCharts

    // ── Precipitation Charts ─────────────────────────────────────────────
    // Trailing mean over `window` complete years; null until there are enough, and
    // the in-progress year is left out so a partial total never drags the line down.
    function rollingMean(rows, window) {
        const out = [];
        for (let i = 0; i < rows.length; i++) {
            const slice = rows.slice(Math.max(0, i - window + 1), i + 1)
                              .filter(r => r.year < @currentYear);
            out.push(slice.length === window
                ? slice.reduce((s, r) => s + r.actual, 0) / window
                : null);
        }
        return out;
    }

    function initPrecipCharts() {
    const precipMonthlyData = @Html.Raw(precipMonthlyJson);
    const precipAnnualData  = @Html.Raw(precipAnnualJson);
    const precipHeavyData   = @Html.Raw(precipHeavyJson);
    const precipAnnualTrend = @Html.Raw(precipAnnualTrendJson);
    const currentYear = @currentYear;

    const paccCtx = document.getElementById('precipAccumChart');
    const precipYtdCum = @Html.Raw(precipYtdCumJson);
    if (paccCtx && precipYtdCum.length > 0) {
        const fmtDate = iso => new Date(iso + 'T00:00:00')
            .toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        new Chart(paccCtx, {
            type: 'line',
            data: {
                labels: precipYtdCum.map(d => fmtDate(d.date)),
                datasets: [
                    {
                        label: 'Normal to date',
                        data: precipYtdCum.map(d => d.normal),
                        borderColor: 'rgba(15,23,42,0.5)',
                        borderWidth: 1.5,
                        borderDash: [5, 4],
                        pointRadius: 0,
                        fill: false,
                        order: 1
                    },
                    {
                        label: `${currentYear} actual`,
                        data: precipYtdCum.map(d => d.actual),
                        borderColor: 'rgba(37,99,235,0.95)',
                        borderWidth: 2.5,
                        pointRadius: 0,
                        // Shade the gap: blue where the year is ahead, tan where it is behind.
                        fill: {
                            target: 0,
                            above: 'rgba(37,99,235,0.18)',
                            below: 'rgba(180,130,60,0.20)'
                        },
                        order: 0
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 12 } },
                    tooltip: {
                        callbacks: {
                            title: items => {
                                const d = precipYtdCum[items[0].dataIndex];
                                return new Date(d.date + 'T00:00:00')
                                    .toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
                            },
                            afterBody: items => {
                                const d = precipYtdCum[items[0].dataIndex];
                                const gap = d.actual - d.normal;
                                return `${gap >= 0 ? '+' : ''}${gap.toFixed(2)}" vs. normal to date`;
                            },
                            label: item => `${item.dataset.label}: ${item.parsed.y.toFixed(2)}"`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 24 } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => v + '"' } }
                }
            }
        });
    }

    const pmCtx = document.getElementById('precipMonthlyChart');
    if (pmCtx && precipMonthlyData.length > 0) {
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const labels = precipMonthlyData.map(d => `${monthNames[d.month-1]} ${d.year}`);
        const colors = precipMonthlyData.map(d =>
            (d.actual == null || d.normal == null) ? 'rgba(156,163,175,0.6)'
            : d.actual >= d.normal ? 'rgba(59,130,246,0.75)' : 'rgba(180,120,60,0.7)');
        new Chart(pmCtx, {
            type: 'bar',
            data: { labels, datasets: [
                { label: 'Actual', data: precipMonthlyData.map(d => d.actual), backgroundColor: colors, borderWidth: 0, borderRadius: 2, order: 2 },
                { label: 'Normal', data: precipMonthlyData.map(d => d.normal), type: 'line', borderColor: 'rgba(0,0,0,0.35)', borderWidth: 1.5, borderDash: [4,3], pointRadius: 2, pointBackgroundColor: 'rgba(0,0,0,0.35)', fill: false, order: 1 }
            ]},
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 12 } }, tooltip: { callbacks: { label: item => item.dataset.type === 'line' ? `Normal: ${item.raw}"` : `Actual: ${item.raw}"` } } },
                scales: { x: { grid: { display: false }, ticks: { maxRotation: 45, font: { size: 10 } } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => v + '"' } } } }
        });
    }

    const paCtx = document.getElementById('precipAnnualChart');
    if (paCtx && precipAnnualData.length > 0) {
        const completeAnnual = precipAnnualData.filter(d => d.year < currentYear && d.normal != null);
        const annualAvg = completeAnnual.length ? completeAnnual.reduce((s, d) => s + d.actual, 0) / completeAnnual.length : null;
        const annualColors = precipAnnualData.map(d =>
            d.year === currentYear ? 'rgba(234,179,8,0.85)'
            : (annualAvg == null || d.actual >= annualAvg) ? 'rgba(59,130,246,0.72)' : 'rgba(180,130,60,0.72)');
        new Chart(paCtx, {
            type: 'bar',
            data: { labels: precipAnnualData.map(d => d.year), datasets: [
                { label: 'Annual total', data: precipAnnualData.map(d => d.actual), backgroundColor: annualColors, borderWidth: 0, borderRadius: 2, order: 2 },
                ...(annualAvg != null ? [{ label: `Avg ${annualAvg.toFixed(1)}"`, data: precipAnnualData.map(() => annualAvg), type: 'line', borderColor: 'rgba(0,0,0,0.4)', borderWidth: 1.5, borderDash: [4,4], pointRadius: 0, fill: false, order: 1 }] : []),
                // A ten-year trailing mean rides out single wet years; the fitted line
                // gives the direction a number.
                { label: '10-year average', data: rollingMean(precipAnnualData, 10), type: 'line', borderColor: 'rgba(15,23,42,0.75)', borderWidth: 2, pointRadius: 0, spanGaps: false, fill: false, order: 0 },
                ...(precipAnnualTrend ? [{
                    label: `Trend ${precipAnnualTrend.perDecade >= 0 ? '+' : ''}${precipAnnualTrend.perDecade.toFixed(2)}"/decade`,
                    data: precipAnnualData.map(d => precipAnnualTrend.intercept + precipAnnualTrend.perYear * d.year),
                    type: 'line', borderColor: 'rgba(37,99,235,0.9)', borderWidth: 2, borderDash: [6,3], pointRadius: 0, fill: false, order: 0
                }] : [])
            ]},
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: true, position: 'top', labels: { boxWidth: 12, padding: 12 } }, tooltip: { callbacks: {
                    title: items => { const d = precipAnnualData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (partial)` : String(d.year); },
                    label: item => item.dataset.type === 'line'
                        ? (item.parsed.y == null ? null : `${item.dataset.label}: ${item.parsed.y.toFixed(2)}"`)
                        : `Total: ${item.raw}"` } } },
                scales: { x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? precipAnnualData[i]?.year : '' } }, y: { beginAtZero: false, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { callback: v => v + '"' } } } }
        });
    }

    const phCtx = document.getElementById('precipHeavyChart');
    if (phCtx && precipHeavyData.length > 0) {
        new Chart(phCtx, {
            type: 'bar',
            data: { labels: precipHeavyData.map(d => d.year), datasets: [{ label: 'Days ≥ 1.0"', data: precipHeavyData.map(d => d.count), backgroundColor: precipHeavyData.map(d => d.year === currentYear ? 'rgba(234,179,8,0.85)' : 'rgba(79,70,229,0.65)'), borderWidth: 0, borderRadius: 2 }] },
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: {
                    title: items => { const d = precipHeavyData[items[0].dataIndex]; return d.year === currentYear ? `${d.year} (through yesterday)` : String(d.year); },
                    label: item => `${item.raw} days with ≥ 1.0"` } } },
                scales: { x: { grid: { display: false }, ticks: { maxRotation: 0, callback: (val, i) => i % 5 === 0 ? precipHeavyData[i]?.year : '' } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' } } } }
        });
    }
    } // end initPrecipCharts
})();
</script>
}
